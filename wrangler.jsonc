{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tubot-sf-auth",
  "account_id": "3b27bbae23636a0e40eff144e12d7317",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "PANEL_JWT_SIGNER",
      "service": "tubot-new-panel",
      "entrypoint": "PanelJwtSigner"
    },
    {
      "binding": "DATA360",
      "service": "tubot-sf-data360-production"
    }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "agent-dashboard-db-production",
    "database_id": "9ffc87cf-dcd6-4e34-8537-49ca46fdbe96",
    "migrations_dir": "migrations",
    "migrations_table": "tubot_sf_auth_migrations"
  }],
  "observability": {
    "enabled": true,
    // Billing: automatic invocation logs + traces bill per persisted event
    // (Oct 2026: ~21M events ≈ $0.72). App console logs still persist.
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 },
    "traces": { "enabled": false }
  },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "tubot-sf-auth-staging",
      "workers_dev": false,
      "preview_urls": false,
      "services": [
        {
          "binding": "PANEL_JWT_SIGNER",
          "service": "tubot-new-panel-staging",
          "entrypoint": "PanelJwtSigner"
        },
        {
          "binding": "DATA360",
          "service": "tubot-sf-data360"
        }
      ],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "agent-dashboard-db-staging",
        "database_id": "572e8088-0bf1-415d-b907-a9fbc62b63ed",
        "migrations_dir": "migrations",
        "migrations_table": "tubot_sf_auth_migrations"
      }],
      "observability": {
        "enabled": true,
        // Billing: automatic invocation logs + traces bill per persisted event
        // (Oct 2026: ~21M events ≈ $0.72). App console logs still persist.
        "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 },
        "traces": { "enabled": false }
      },
      "upload_source_maps": true
    }
  }
}
