{
	"name": "tubot-sf-auth",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy --env production",
		"deploy:staging": "wrangler deploy --env staging",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"jwt-api-smoke": "bun scripts/jwt-api-smoke.ts",
