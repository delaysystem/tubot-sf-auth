<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants access to Omni-Channel Supervisor tab, console application, and monitoring capabilities</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Omni Supervisor Access</label>
    <applicationVisibilities>
        <application>Omni_Supervisor</application>
        <visible>true</visible>
    </applicationVisibilities>
    <tabSettings>
        <tab>standard-OmniSupervisor</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>standard-OmniSupervisorLightning</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
