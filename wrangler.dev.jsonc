{
  // Local-dev config: `wrangler dev -c wrangler.dev.jsonc --port <port>`.
  // Uses a local D1 database and a module-entry shim for local Workerd.
  // Service bindings omitted: local probes use this Worker's D1 binding directly.
  // NEVER deploy with this config.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tubot-sf-auth-staging",
  "main": "src/dev-entry.ts",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "agent-dashboard-db-staging",
    "database_id": "572e8088-0bf1-415d-b907-a9fbc62b63ed",
    "migrations_dir": "migrations",
    "migrations_table": "tubot_sf_auth_migrations"
  }],
  // observability-exception: local-only, never deployed (wrangler dev streams locally, nothing persists).
  "observability": { "enabled": true },
  "upload_source_maps": true
}
